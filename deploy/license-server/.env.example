# Public domain of the license server (DNS must point here). Caddy gets the certificate automatically.
LICENSE_DOMAIN=licenses.yourdomain.com
# Output of: dotnet SloomyTweaks.LicenseServer.dll hash-admin-key <your admin key>
Sloomy__AdminKeySha256=
# Output of: dotnet SloomyTweaks.LicenseServer.dll generate-pepper   (keep it forever: changing it invalidates all keys)
Sloomy__KeyPepper=
Sloomy__SigningKeyId=k1
Sloomy__TokenLifetimeHours=72
