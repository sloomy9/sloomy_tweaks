<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dependency-free test suite. It uses a minimal xUnit-compatible surface ([Fact], Assert.*)
    implemented in TestFramework/, so it runs with `dotnet run` on machines without NuGet access.
    To move to xUnit later: add the xunit packages, delete TestFramework/, set OutputType to Library.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SloomyTweaks.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1822;CA1861;CA2007;CA1305;CA1051;CA1826</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SloomyTweaks.Core\SloomyTweaks.Core.csproj" />
    <ProjectReference Include="..\..\src\SloomyTweaks.Data\SloomyTweaks.Data.csproj" />
    <ProjectReference Include="..\..\src\SloomyTweaks.Presentation\SloomyTweaks.Presentation.csproj" />
    <ProjectReference Include="..\..\src\SloomyTweaks.Platform.Windows\SloomyTweaks.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\SloomyTweaks.LicenseServer\SloomyTweaks.LicenseServer.csproj" />
  </ItemGroup>
</Project>
