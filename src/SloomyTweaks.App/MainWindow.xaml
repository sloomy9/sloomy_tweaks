<Window x:Class="SloomyTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SloomyTweaks.Presentation.ViewModels;assembly=SloomyTweaks.Presentation"
        Title="Sloomy Tweaks"
        Width="1320" Height="860" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Primary}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/SloomyTweaks.png">

    <!-- Custom title bar: WindowChrome keeps native snapping, resizing and the Windows 11 shadow and rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Compensate for the off-screen frame Windows adds to maximized windows. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource Bg.Secondary}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="Assets/SloomyTweaks.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Border}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding LicenseBadge}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Border}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ElevationText}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        </Border>
                        <Button Content="Restart as administrator" Style="{StaticResource Button.Link}" Command="{Binding RestartAsAdminCommand}"
                                FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Some optimizations change system-wide settings and need administrator rights." />
                        <Button Content="&#xE921;" Style="{StaticResource Button.TitleBar}" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource Button.TitleBar}" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Content="&#xE8BB;" Style="{StaticResource Button.TitleBarClose}" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Sidebar ===== -->
            <Border Grid.Row="1" Background="{StaticResource Bg.Secondary}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,12,10,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Width="22" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="10" Margin="8,0,0,0" Opacity="0.6"
                                                   Visibility="{Binding RequiresLicense, Converter={StaticResource BoolToVis}}" ToolTip="Requires a license" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ===== Content ===== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- ===== First-run activation overlay ===== -->
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#D90B0B10"
                  Visibility="{Binding ShowActivation, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Width="500" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Image Source="Assets/SloomyTweaks.png" Width="48" Height="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Activate Sloomy Tweaks" Style="{StaticResource Text.PageTitle}" FontSize="22" Margin="0,18,0,6" />
                        <TextBlock Text="Enter the license key from your purchase confirmation." Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="LICENSE KEY" Style="{StaticResource Text.Label}" Margin="0,20,0,4" />
                        <TextBox Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="14" />
                        <TextBlock Text="{Binding ActivationMessage}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding ActivationMessage, Converter={StaticResource HasValueToVis}}" />
                        <Button Content="Activate" Style="{StaticResource Button.Primary}" Command="{Binding ActivateCommand}" Margin="0,18,0,0" Padding="16,10" />
                        <Button Content="Continue with limited access" Style="{StaticResource Button.Link}" Command="{Binding SkipActivationCommand}"
                                HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="Without a license you can view your system, browse the evidence registry and restore any change Sloomy Tweaks made."
                                   Style="{StaticResource Text.Muted}" FontSize="12" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
