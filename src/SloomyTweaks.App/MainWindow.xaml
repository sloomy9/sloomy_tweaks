<Window x:Class="SloomyTweaks.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SloomyTweaks.Presentation.ViewModels;assembly=SloomyTweaks.Presentation"
        Title="Sloomy Tweaks"
        Width="1360" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Primary}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="Assets/SloomyTweaks.png">

    <!-- Custom chrome keeps native snapping, resizing and the shadow; Windows 11 rounds the corners (see WindowCorners). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Compensate for the off-screen frame Windows adds to maximized windows. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource Bg.Sidebar}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image Source="Assets/SloomyTweaks.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="8,1,0,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" Background="{StaticResource Warning.Subtle}" BorderBrush="#66F59E0B" Margin="12,0,0,0"
                                Visibility="{Binding DevelopmentBadge, Converter={StaticResource HasValueToVis}}"
                                ToolTip="licensing.json declares a development license server. This build must not be distributed to customers.">
                            <TextBlock Text="{Binding DevelopmentBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Border}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LicenseBadge}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Border}" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ElevationText}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                        </Border>
                        <Button Content="Restart as administrator" Style="{StaticResource Button.Link}" Command="{Binding RestartAsAdminCommand}"
                                FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                ToolTip="Some optimizations change system-wide settings and need administrator rights." />
                        <Button Content="&#xE921;" Style="{StaticResource Button.TitleBar}" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource Button.TitleBar}" Click="Maximize_Click" ToolTip="Maximize" />
                        <Button Content="&#xE8BB;" Style="{StaticResource Button.TitleBarClose}" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Sidebar (only with a valid license) ===== -->
            <Border Grid.Row="1" Width="252" Background="{StaticResource Bg.Sidebar}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,16">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Accent.Subtle}" BorderBrush="{StaticResource Accent.Border}" BorderThickness="1">
                            <Image Source="Assets/SloomyTweaks.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sloomy Tweaks" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Gaming optimization" FontSize="11" Foreground="{StaticResource Text.Tertiary}" />
                        </StackPanel>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card.Inner}" Margin="14,8,14,16">
                        <StackPanel>
                            <TextBlock Text="LICENSE" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding LicenseBadge}" FontSize="12" Foreground="{StaticResource Text.Primary}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavItems}" Margin="12,4,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                    <Button Style="{StaticResource NavButton}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Width="22" />
                                            <TextBlock Text="{Binding Title}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Content (only with a valid license) ===== -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"
                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />

            <!-- ===== Activation screen: the whole window when there is no valid license ===== -->
            <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding Activation}" Focusable="False"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />

            <!-- ===== Startup ===== -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}">
                <Image Source="Assets/SloomyTweaks.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Checking license…" Style="{StaticResource Text.Muted}" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
