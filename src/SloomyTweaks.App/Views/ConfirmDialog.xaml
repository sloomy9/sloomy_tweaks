<Window x:Class="SloomyTweaks.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg.Secondary}" Foreground="{StaticResource Text.Primary}"
        FontFamily="{StaticResource UiFont}" BorderBrush="{StaticResource Border}" BorderThickness="1">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.PageTitle}" FontSize="19" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,20" MaxHeight="520">
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="96" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource Button.Primary}" Click="Confirm_Click" MinWidth="96" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
