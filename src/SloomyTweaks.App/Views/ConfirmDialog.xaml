<Window x:Class="SloomyTweaks.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="580" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource Text.Primary}" FontFamily="{StaticResource UiFont}">
    <!-- 16 px radius dialog with a soft shadow; the outer margin leaves room for the shadow. -->
    <Border Margin="18" Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusDialog}" Effect="{StaticResource DialogShadow}" MouseLeftButtonDown="Header_MouseDown">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.PageTitle}" FontSize="19" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,22" MaxHeight="520">
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,10,0" MinWidth="100" IsCancel="True" />
                <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource Button.Primary}" Click="Confirm_Click" MinWidth="100" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
