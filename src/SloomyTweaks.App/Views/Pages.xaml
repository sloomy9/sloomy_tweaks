<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SloomyTweaks.Presentation.ViewModels;assembly=SloomyTweaks.Presentation"
                    xmlns:bench="clr-namespace:SloomyTweaks.Core.Benchmark;assembly=SloomyTweaks.Core"
                    xmlns:net="clr-namespace:SloomyTweaks.Core.Network;assembly=SloomyTweaks.Core"
                    xmlns:proc="clr-namespace:SloomyTweaks.Core.Processes;assembly=SloomyTweaks.Core"
                    xmlns:ctl="clr-namespace:SloomyTweaks.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SloomyTweaks;component/Views/Cards.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared page header: title, subtitle, loading and error states -->
    <DataTemplate x:Key="PageHeader">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
            <TextBlock Text="Loading…" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <Border Background="{StaticResource Danger.Subtle}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Body}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Small dashboard tile -->
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card.Grid}">
        <Setter Property="MinHeight" Value="104" />
    </Style>

    <!-- ===================== Dashboard ===================== -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1240">
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                    <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>

                <ctl:AdaptiveGrid MinColumnWidth="260" MaxColumns="3" Spacing="16" Margin="0,0,0,16">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="PROCESSOR" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                                <Run Text="Driver" /> <Run Text="{Binding GpuDriver, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding AdditionalGpus}" Style="{StaticResource Text.Muted}"
                                       Visibility="{Binding AdditionalGpus, Converter={StaticResource HasValueToVis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding InstalledRam}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MemoryUsage}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="MOTHERBOARD" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding Motherboard}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="WINDOWS" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WindowsBuild}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="POWER PLAN" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding PowerPlan}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                                <Run Text="Uptime" /> <Run Text="{Binding Uptime, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ctl:AdaptiveGrid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="CPU UTILIZATION" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="MEMORY UTILIZATION" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding MemoryPercent, StringFormat={}{0:0}%}" Style="{StaticResource Text.Value}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource Meter}" Value="{Binding MemoryPercent, Mode=OneWay}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ctl:AdaptiveGrid MinColumnWidth="260" MaxColumns="3" Spacing="16" Margin="0,0,0,16">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="LICENSE" Style="{StaticResource Text.Label}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LicenseStatus}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="APPLIED BY SLOOMY TWEAKS" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding AppliedCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                            <TextBlock Text="Restorable from the Restore Center" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="RECOMMENDED, NOT YET APPLIED" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" />
                            <TextBlock Text="Verified or Documented and compatible" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </Border>
                </ctl:AdaptiveGrid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LAST BENCHMARK" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LastBenchmark}" Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Category page ===================== -->
    <DataTemplate DataType="{x:Type vm:CategoryPageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1240">
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Read the current configuration from Windows again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Re-check" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Diagnostics: information only, never changes the system -->
                <ItemsControl ItemsSource="{Binding Sections}" ItemsPanel="{StaticResource InfoGridPanel}" Margin="0,0,0,16"
                              Visibility="{Binding HasSections, Converter={StaticResource BoolToVis}}" />

                <!-- Windows Settings shortcuts -->
                <StackPanel Margin="0,0,0,12" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="OPEN IN WINDOWS SETTINGS" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Links}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                </StackPanel>

                <!-- Optimizations -->
                <TextBlock Text="Optimizations" Style="{StaticResource Text.Section}" Margin="0,4,0,12"
                           Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource CardGridPanel}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </Border>

                <!-- Not offered, and why -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasNotOffered, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Not offered by Sloomy Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" />
                                <TextBlock Text="Popular tweaks that are unsupported, unsafe or without evidence, and why they are excluded."
                                           Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource Button.Link}" Command="{Binding ToggleNotOfferedCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Show" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowNotOffered}" Value="True">
                                                    <Setter Property="Text" Value="Hide" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding NotOffered}" Margin="0,8,0,0"
                                      Visibility="{Binding ShowNotOffered, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Benchmark Center ===================== -->
    <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32" MaxWidth="1100">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Measurement method" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{Binding Methodology}" Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Import a capture" Style="{StaticResource Text.Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CONFIGURATION LABEL" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ImportLabel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Import PresentMon CSV…" Style="{StaticResource Button.Primary}" Command="{Binding ImportCommand}"
                                    VerticalAlignment="Bottom" Margin="12,0,0,0" />
                            <Button Grid.Column="3" Content="Export results…" Style="{StaticResource Button.Secondary}" Command="{Binding ExportCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="Compare configurations" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Labels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Use as baseline" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Padding="12,5"
                                                Command="{Binding DataContext.SetBaselineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="Use as candidate" Style="{StaticResource Button.Secondary}" Padding="12,5"
                                                Command="{Binding DataContext.SetCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center">
                                <Run Text="Baseline:" /> <Run Text="{Binding BaselineLabel, Mode=OneWay, TargetNullValue='(none)'}" Foreground="{StaticResource Text.Primary}" />
                                <Run Text="   Candidate:" /> <Run Text="{Binding CandidateLabel, Mode=OneWay, TargetNullValue='(none)'}" Foreground="{StaticResource Text.Primary}" />
                            </TextBlock>
                            <Button Content="Compare" Style="{StaticResource Button.Primary}" Command="{Binding CompareCommand}" Margin="16,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Comparison}" Margin="0,16,0,0" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bench:MetricComparison}">
                                    <Border Style="{StaticResource Card.Inner}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Metric}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}">
                                                <Run Text="Baseline" /> <Run Text="{Binding BaselineMean, Mode=OneWay, Converter={StaticResource Num}, ConverterParameter=0.##}" Foreground="{StaticResource Text.Primary}" />
                                                <Run Text="{Binding BaselineRuns, Mode=OneWay, StringFormat='(n={0})'}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Muted}">
                                                <Run Text="Candidate" /> <Run Text="{Binding CandidateMean, Mode=OneWay, Converter={StaticResource Num}, ConverterParameter=0.##}" Foreground="{StaticResource Text.Primary}" />
                                                <Run Text="{Binding CandidateRuns, Mode=OneWay, StringFormat='(n={0})'}" />
                                            </TextBlock>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" Foreground="{Binding Verdict, Converter={StaticResource VerdictBrush}}" />
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Muted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recorded runs" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="No runs yet. Import a PresentMon capture to begin." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Runs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bench:BenchmarkRun}">
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.Body}">
                                                    <Run Text="{Binding ConfigurationLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="·" Foreground="{StaticResource Text.Secondary}" />
                                                    <Run Text="{Binding Application, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Text.Muted}">
                                                    <Run Text="{Binding Stats.AverageFps, Mode=OneWay, StringFormat={}{0:0.#} avg FPS}" />
                                                    <Run Text="{Binding Stats.OnePercentLowFps, Mode=OneWay, StringFormat={}· {0:0.#} 1% low}" />
                                                    <Run Text="{Binding Stats.P99FrameTimeMs, Mode=OneWay, StringFormat={}· P99 {0:0.##} ms}" />
                                                    <Run Text="{Binding Stats.FrameCount, Mode=OneWay, StringFormat={}· {0:N0} frames}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Delete" Style="{StaticResource Button.Danger}" Padding="12,5" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Network ===================== -->
    <DataTemplate x:Key="LatencyCard" DataType="{x:Type net:LatencyStats}">
        <StackPanel>
            <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0">
                <Run Text="Average" /> <Run Text="{Binding AverageMs, Mode=OneWay, Converter={StaticResource Num}}" Foreground="{StaticResource Text.Primary}" /> <Run Text="ms" />
                <Run Text="  ·  Min" /> <Run Text="{Binding MinMs, Mode=OneWay, Converter={StaticResource Num}}" /> <Run Text="  ·  Max" /> <Run Text="{Binding MaxMs, Mode=OneWay, Converter={StaticResource Num}}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Muted}">
                <Run Text="Jitter" /> <Run Text="{Binding JitterMs, Mode=OneWay, Converter={StaticResource Num}, ConverterParameter=0.##}" Foreground="{StaticResource Text.Primary}" /> <Run Text="ms  ·  Loss" />
                <Run Text="{Binding LossPercent, Mode=OneWay, StringFormat={}{0:0.#}%}" Foreground="{StaticResource Text.Primary}" />
                <Run Text="{Binding Received, Mode=OneWay, StringFormat={}({0}}" /><Run Text="{Binding Sent, Mode=OneWay, StringFormat={}/{0} replies)}" />
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32" MaxWidth="1100">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Active adapters" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type net:AdapterInfo}">
                                    <Border Style="{StaticResource Card.Inner}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Body}">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="·" Foreground="{StaticResource Text.Secondary}" />
                                                <Run Text="{Binding SpeedBitsPerSecond, Mode=OneWay, Converter={StaticResource Bps}}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Style="{StaticResource Text.Muted}">
                                                <Run Text="DNS:" /> <Run Text="{Binding DnsServers, Mode=OneWay, Converter={StaticResource Join}}" />
                                                <Run Text="  ·  Gateway:" /> <Run Text="{Binding Gateways, Mode=OneWay, Converter={StaticResource Join}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="280">
                                <TextBlock Text="INTERNET TEST TARGET" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Content="Run diagnostics" Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <Border Style="{StaticResource Card.Inner}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="LOCAL NETWORK (DEFAULT GATEWAY)" Style="{StaticResource Text.Label}" />
                                    <ContentPresenter Content="{Binding Gateway}" ContentTemplate="{StaticResource LatencyCard}" />
                                    <TextBlock Text="Not measured yet" Style="{StaticResource Text.Muted}" Visibility="{Binding Gateway, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card.Inner}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="INTERNET PATH" Style="{StaticResource Text.Label}" />
                                    <ContentPresenter Content="{Binding Internet}" ContentTemplate="{StaticResource LatencyCard}" />
                                    <TextBlock Text="Not measured yet" Style="{StaticResource Text.Muted}" Visibility="{Binding Internet, Converter={StaticResource HasValueToVis}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="{Binding Interpretation}" Style="{StaticResource Text.Body}" Margin="0,14,0,0"
                                   Visibility="{Binding Interpretation, Converter={StaticResource HasValueToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Processes & Services ===================== -->
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32" MaxWidth="1100">
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                    <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <Border Background="{StaticResource Accent.Subtle}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Policy}" Style="{StaticResource Text.Body}" />
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Top processes" Style="{StaticResource Text.Section}" />
                        <ListBox ItemsSource="{Binding Processes}" Style="{StaticResource PlainList}" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type proc:ProcessEntry}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CpuPercent, Converter={StaticResource Num}, StringFormat={}{0}% CPU}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding WorkingSetBytes, Converter={StaticResource Bytes}}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Grid.Column="3" Text="Protected" Foreground="{StaticResource Warning}" FontSize="12"
                                                   Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Startup applications" Style="{StaticResource Text.Section}" />
                        <ItemsControl ItemsSource="{Binding Startup}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type proc:StartupEntry}">
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Services" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0" />
                            <TextBox Text="{Binding ServiceFilter, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Right" ToolTip="Filter services" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Services}" Style="{StaticResource PlainList}" Height="420">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type proc:ServiceEntry}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Text.Secondary}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding DependsOn, Mode=OneWay, Converter={StaticResource Join}, StringFormat={}  · depends on: {0}}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StartType}" Style="{StaticResource Text.Muted}" />
                                        <TextBlock Grid.Column="3" Text="Protected" Foreground="{StaticResource Warning}" FontSize="12"
                                                   Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- History list (used inside Restore Center) -->
    <DataTemplate DataType="{x:Type vm:HistoryItem}">
        <Border BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,140,0">
                        <Run Text="{Binding Optimization, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="·" Foreground="{StaticResource Text.Secondary}" />
                        <Run Text="{Binding Action, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" />
                    </TextBlock>
                    <TextBlock Text="{Binding When}" Style="{StaticResource Text.Small}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding Outcome}" FontSize="12" Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Success}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Margin="0,3,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BEFORE" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding Before}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AFTER" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding After}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===================== Restore Center (also reachable from the activation screen) ===================== -->
    <DataTemplate DataType="{x:Type vm:RestoreCenterViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="1240">
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <Button Content="Restore all" Style="{StaticResource Button.Primary}" Command="{Binding RestoreAllCommand}" />
                    </StackPanel>
                </Grid>
                <Border Background="{StaticResource Accent.Subtle}" CornerRadius="{StaticResource RadiusControl}" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" />
                </Border>

                <TextBlock Text="Active changes" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" Foreground="{StaticResource Success}" Margin="0,0,12,0" />
                        <TextBlock Text="Nothing to restore. Sloomy Tweaks has no active changes on this PC." Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource CardGridPanel}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RestoreItemViewModel}">
                            <Border Style="{StaticResource Card.Grid}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource Button.Secondary}" Command="{Binding RestoreCommand}"
                                            VerticalAlignment="Top" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Text.Small}" Margin="0,2,0,0">
                                            <Run Text="Original saved" /> <Run Text="{Binding SavedAt, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Values}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Requires administrator rights: restart Sloomy Tweaks as administrator to restore this." Foreground="{StaticResource Warning}" FontSize="12" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding BlockedByElevation, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="History" Style="{StaticResource Text.Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="No operations recorded yet." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding History.IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding History.Items}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Settings ===================== -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32" MaxWidth="820" HorizontalAlignment="Left">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource Text.Section}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,6">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="Starts minimized for the current user, without administrator rights." Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotifications}" Margin="0,6">
                            <TextBlock Text="Show notifications" Style="{StaticResource Text.Body}" />
                        </CheckBox>
                        <TextBlock Text="THEME" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                        <TextBlock Text="{Binding ThemeNote}" Style="{StaticResource Text.Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Safety and restore" Style="{StaticResource Text.Section}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateRestorePoints}" Margin="0,6">
                            <StackPanel>
                                <TextBlock Text="Create a System Restore point before system-wide changes" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="In addition to Sloomy Tweaks' own per-setting backups. Windows limits how often restore points can be created." Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Data and logs" Style="{StaticResource Text.Section}" />
                        <Grid Margin="0,4">
                            <TextBlock Text="Benchmark runs to keep" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding BenchmarkHistoryLimit}" Width="100" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,8">
                            <TextBlock Text="Log retention (days)" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding LogRetentionDays}" Width="100" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open log folder" Style="{StaticResource Button.Secondary}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                            <Button Content="Open data folder" Style="{StaticResource Button.Secondary}" Command="{Binding OpenDataCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Updates and license" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{Binding UpdateNote}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding LicenseSummary}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="About Sloomy Tweaks" Style="{StaticResource Text.Section}" />
                        <TextBlock Style="{StaticResource Text.Muted}"><Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding About}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save settings" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== License & Account ===================== -->
    <DataTemplate DataType="{x:Type vm:LicenseViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,32" MaxWidth="820" HorizontalAlignment="Left">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="License status" Style="{StaticResource Text.Section}" />
                            <Button Content="Check now" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="12,5" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="STATUS" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Value}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="PLAN" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding PlanText}" Style="{StaticResource Text.Value}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="EXPIRES" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding ExpiresText}" Style="{StaticResource Text.Value}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Muted}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <Run Text="Works offline until" /> <Run Text="{Binding OfflineUntilText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Deactivate this device" Style="{StaticResource Button.Danger}" Command="{Binding DeactivateCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="Activate" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="LICENSE KEY" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <Button Content="Activate" Style="{StaticResource Button.Primary}" Command="{Binding ActivateCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Privacy" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{Binding PrivacyNote}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="DEVICE ID (HASHED)" Style="{StaticResource Text.Label}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding DeviceId, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Activation screen (shown instead of the app without a license) ===================== -->
    <DataTemplate DataType="{x:Type vm:ActivationViewModel}">
        <Grid>
            <!-- Subtle brand glow -->
            <Ellipse Width="760" Height="760" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#338B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Activation card -->
            <Border Width="460" Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusContainer}" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource DialogShadow}" Visibility="{Binding ShowRestore, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <Image Source="/SloomyTweaks;component/Assets/SloomyTweaks.png" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Sloomy Tweaks" Style="{StaticResource Text.PageTitle}" FontSize="24" Margin="0,18,0,4" />
                    <TextBlock Text="Activate your license to continue." Style="{StaticResource Text.Muted}" />

                    <Border Background="{StaticResource Warning.Subtle}" BorderBrush="#66F59E0B" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,9" Margin="0,16,0,0" Visibility="{Binding IsDevelopmentMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Development mode: this build uses a test license server. It is not a production build." Style="{StaticResource Text.Small}" Foreground="{StaticResource Warning}" />
                    </Border>

                    <TextBlock Text="LICENSE KEY" Style="{StaticResource Text.Label}" Margin="0,22,0,6" />
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="14"
                             IsEnabled="{Binding IsConfigured}" AutomationProperties.Name="License key" />
                    <Border Background="{StaticResource Bg.Elevated}" CornerRadius="{StaticResource RadiusControl}" Padding="12,9" Margin="0,12,0,0"
                            Visibility="{Binding Message, Converter={StaticResource HasValueToVis}}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Small}" Foreground="{StaticResource Text.Primary}" />
                    </Border>
                    <Button Content="Activate" Style="{StaticResource Button.Primary}" Command="{Binding ActivateCommand}" Margin="0,18,0,0" Padding="16,11" IsDefault="True" />

                    <Border Style="{StaticResource Divider}" Margin="0,24,0,16" />
                    <Button Style="{StaticResource Button.Link}" Command="{Binding ShowRestoreCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restore changes made by Sloomy Tweaks" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Restoring your original Windows settings is always available, with or without a license." Style="{StaticResource Text.Small}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Small}" Margin="0,16,0,0" Foreground="{StaticResource Text.Tertiary}">
                        <Run Text="Device ID:" /> <Run Text="{Binding DeviceId, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Restore-only view -->
            <Border Background="{StaticResource Bg.Primary}" Visibility="{Binding ShowRestore, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Button.Link}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="32,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Back to activation" />
                        </StackPanel>
                    </Button>
                    <ContentPresenter Content="{Binding RestoreCenter}" />
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
